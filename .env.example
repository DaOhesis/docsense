# Copy to .env and fill in values as needed.

# Database (SQLite default; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./docint.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/docint

# Directory where uploaded files are stored (created automatically on startup)
UPLOAD_DIR=./uploads

# URL the Streamlit review UI uses to reach the API
API_URL=http://localhost:8000
